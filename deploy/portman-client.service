[Unit]
Description=Portman TLS Bridge Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portman
Group=portman
ExecStart=/usr/local/bin/portman -config /etc/portman/client.json
Restart=on-failure
RestartSec=3

StateDirectory=portman
StateDirectoryMode=0750
LogsDirectory=portman
LogsDirectoryMode=0750

NoNewPrivileges=true
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target