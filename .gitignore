# build output
/dist/
/bin/
/portman

# not published: local notes, docs, plain-text files
/docs/
*.txt

# real configs: only example configs are tracked
/configs/
*.json
!examples/*.json

# logs and captures
*.log
*.pcap

# editor and OS files
.vscode/
.idea/
.DS_Store

# certificates and keys (for client authentication)
/certificates/
*.pem
*.key
*.csr
*.srl
*.ext